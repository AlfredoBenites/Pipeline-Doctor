# Pipeline Doctor - copy to .env and fill in ONE api key.
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit a real key.
#
# The repair agent picks a provider based on which key is present, in this order:
#   1. GROQ_API_KEY        2. OPENROUTER_API_KEY        3. GEMINI_API_KEY
# so you can swap providers without touching any code.

# --- Option 1: Groq (recommended: free, no card, generous limits) -----------------
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# --- Option 2: OpenRouter (free models available) ---------------------------------
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Option 3: Google Gemini ------------------------------------------------------
# Get one at https://aistudio.google.com/apikey
# NOTE: the free API tier is only 20 requests/day for gemini-3.6-flash, and it is
# separate from any Gemini app subscription (including the student plan).
GEMINI_API_KEY=

# --- Optional overrides ------------------------------------------------------------
# Pin a specific model for whichever provider is active.
#   Groq       e.g. openai/gpt-oss-120b       (default)
#   OpenRouter e.g. meta-llama/llama-3.3-70b-instruct:free   (default)
#   Gemini     e.g. gemini-3.6-flash          (default)
# AI_MODEL=

# Point at any other OpenAI-compatible endpoint (Together, Cerebras, a local server).
# Only used with GROQ_API_KEY or OPENROUTER_API_KEY.
# AI_BASE_URL=

# Target repository, if you do not pass it as an argument to main.bxs.
# PIPELINE_DOCTOR_TARGET=../pipeline-doctor-demo
