/**
 * Pipeline Doctor - entry point.
 *
 *   boxlang main.bxs ../pipeline-doctor-demo
 *   boxlang main.bxs ../pipeline-doctor-demo --dry-run
 *
 * The target may also come from the PIPELINE_DOCTOR_TARGET environment variable.
 * With neither, it defaults to ../pipeline-doctor-demo.
 *
 * --dry-run runs everything through verification, then restores the target instead of
 * committing, pushing, or opening a pull request. Use it to rehearse safely.
 *
 * Exit code 0 when the run published a pull request or completed a dry run; 1 otherwise.
 *
 * Pipeline Doctor NEVER merges a pull request.
 */

import src.Pipeline;

cli       = cliGetArgs();
dryRun    = cli.options[ "dry-run" ] ?: false;
targetArg = cli.positionals.len() >= 2
    ? cli.positionals[ 2 ]
    : getSystemSetting( "PIPELINE_DOCTOR_TARGET", "../pipeline-doctor-demo" );

result = new Pipeline().run( getCanonicalPath( expandPath( targetArg ) ), dryRun );

println( "" );
println( repeatString( "=", 78 ) );
println( "  RESULT" );
println( repeatString( "=", 78 ) );
println( jsonSerialize( data: result, pretty: true ) );

cliExit( ( result.status == "published" || result.status == "dry-run-verified" ) ? 0 : 1 );
