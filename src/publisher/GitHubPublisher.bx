class {

	function runCommand( name, commandArguments, workingDirectory ) {
		return systemExecute(
			name               = name,
			arguments          = commandArguments,
			directory          = workingDirectory,
			timeout            = 30,
			terminateOnTimeout = true
		)
	}

	function checkPrerequisites( workingDirectory ) {
		var gitResult = runCommand(
			"git",
			[ "--version" ],
			workingDirectory
		)

		var githubResult = runCommand(
			"gh",
			[ "auth", "status" ],
			workingDirectory
		)

		return {
            gitAvailable       : gitResult.exitCode == 0,
            githubAuthenticated: githubResult.exitCode == 0,
            gitVersion         : gitResult.output,
            error              : githubResult.exitCode == 0 ? "" : githubResult.error
        }
	}

    function inspectRepository( workingDirectory ) {
        var repositoryResult = runCommand(
            "git",
            [ "rev-parse", "--is-inside-work-tree" ],
            workingDirectory
        )

        if ( repositoryResult.exitCode != 0 ) {
            return {
                validRepository: false,
                branchName    : "",
                clean         : false,
                changedFiles  : [],
                error         : repositoryResult.error
            }
        }

        var branchResult = runCommand(
            "git",
            [ "branch", "--show-current" ],
            workingDirectory
        )

        var statusResult = runCommand(
            "git",
            [ "status", "--porcelain" ],
            workingDirectory
        )

        var changedFiles = []

        if ( len( trim( statusResult.output ) ) > 0 ) {
            for ( line in listToArray( statusResult.output, char( 10 ) ) ) {
                if ( len( line ) >= 4 ) {
                    changedFiles.append(
                        trim( mid( line, 4, len( line ) - 3 ) )
                    )
                }
            }
        }

        return {
            validRepository: true,
            branchName    : trim( branchResult.output ),
            clean         : changedFiles.len() == 0,
            changedFiles  : changedFiles,
            error         : statusResult.exitCode == 0
                ? ""
                : statusResult.error
        }
    }

    function createRepairBranch(
        workingDirectory,
        baseBranch,
        branchName
    ) {
        var repository = inspectRepository( workingDirectory )

        if ( !repository.validRepository ) {
            return {
                created   : false,
                baseBranch: baseBranch,
                branchName: branchName,
                error     : "The target folder is not a Git repository."
            }
        }

        if ( !repository.clean ) {
            return {
                created   : false,
                baseBranch: baseBranch,
                branchName: branchName,
                error     : "The target repository already has uncommitted changes."
            }
        }

        if ( repository.branchName != baseBranch ) {
            return {
                created   : false,
                baseBranch: baseBranch,
                branchName: branchName,
                error     : "Expected branch " & baseBranch &
                    ", but found " & repository.branchName & "."
            }
        }

        var branchResult = runCommand(
            "git",
            [ "switch", "-c", branchName ],
            workingDirectory
        )

        return {
            created   : branchResult.exitCode == 0,
            baseBranch: baseBranch,
            branchName: branchName,
            error     : branchResult.exitCode == 0
                ? ""
                : branchResult.error
        }
    }
}