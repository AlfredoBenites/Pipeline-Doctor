class {

	function validateForPublish( repairResult, verificationResult ) {
		var errors = []

		if ( !verificationResult.succeeded ) {
			errors.append(
				"Verification failed. A pull request cannot be published."
			)
		}

		if ( !repairResult.repaired ) {
			errors.append(
				"The repair stage did not produce a repair."
			)
		}

		if ( repairResult.changedFiles.len() == 0 ) {
			errors.append(
				"The repair did not report any changed files."
			)
		}

		for ( path in repairResult.changedFiles ) {
			if (
				findNoCase( ".env", path ) > 0 ||
				find( "..", path ) > 0 ||
				left( path, 1 ) == "/"
			) {
				errors.append(
					"Unsafe file path rejected: " & path
				)
			}
		}

		return {
			safe  : errors.len() == 0,
			errors: errors
		}
	}

    function validateChangedFiles( reportedFiles, actualFiles ) {
        var errors = []

        if ( actualFiles.len() == 0 ) {
            errors.append( "Git shows no changed files." )
        }

        for ( path in actualFiles ) {
            if ( reportedFiles.find( path ) == 0 ) {
                errors.append(
                    "Git found an unexpected changed file: " & path
                )
            }
        }

        for ( path in reportedFiles ) {
            if ( actualFiles.find( path ) == 0 ) {
                errors.append(
                    "The repair reported a file that Git does not show: " & path
                )
            }
        }

        return {
            safe  : errors.len() == 0,
            errors: errors
        }
    }

}