class {

    /**
     * Build the failure context handed to the RepairAgent.
     *
     * @commandResult Result from CommandRunner.run()
     * @repoPath      Absolute path to the target repository
     * @config        The target's pipeline-doctor.json
     */
    function build( required commandResult, required repoPath, required config ) {

        failureOutput = commandResult.combinedOutput;

        // We already know which file we are permitted to repair, so rather than parsing a
        // language-specific stack trace we simply confirm the failure output mentions that
        // file, then pull out a line number if one is nearby. This works for Java
        // ("App.java:4"), Python ('File "src/app.py", line 3'), Node, Ruby and friends.
        sourceFileName = getFileFromPath( config.sourceFile ?: config.arguments[ 1 ] );
        escapedName    = reReplace( sourceFileName, "([.\[\]{}()*+?^$|\\])", "\\\1", "all" );

        mentioned  = reFindNoCase( escapedName, failureOutput ) > 0;
        lineNumber = "";

        // "App.java:4"  /  "app.js:12"
        lineMatch = reFind( escapedName & "[""'\)]?:([0-9]+)", failureOutput, 1, true );
        if ( arrayLen( lineMatch.match ) >= 2 ) {
            lineNumber = lineMatch.match[ 2 ];
        } else {
            // 'File "src/app.py", line 3'
            lineMatch = reFindNoCase( escapedName & "[""']?,\s*line\s+([0-9]+)", failureOutput, 1, true );
            if ( arrayLen( lineMatch.match ) >= 2 ) {
                lineNumber = lineMatch.match[ 2 ];
            }
        }

        // The path we are actually allowed to repair, straight from pipeline-doctor.json.
        // Deliberately not hardcoded so this class stays reusable across target repositories.
        //
        // Prefer an explicit "sourceFile" setting. Falling back to arguments[1] only works
        // when the command IS the source file (e.g. `java src/App.java`); it breaks for
        // build tools and classpath invocations like `mvn test` or `java -cp out Main`,
        // where argument 1 is "test" or "-cp" rather than a path.
        relativeSourcePath = config.sourceFile ?: config.arguments[ 1 ];
        sourcePath         = repoPath & "/" & relativeSourcePath;

        if ( !mentioned ) {
            return {
                repoPath          : repoPath,
                failureOutput     : failureOutput,
                candidateFiles    : [],
                sourceSnippets    : {},
                lineNumber        : "",
                relativeSourcePath: relativeSourcePath,
                contextFound      : false,
                reason            : "The failure output does not mention the configured source file (" &
                    relativeSourcePath & "), so the failure is probably in a different file."
            };
        }

        fileExtension = listLast( relativeSourcePath, "." );

        if ( !config.allowedExtensions.findNoCase( fileExtension ) ) {
            return {
                repoPath          : repoPath,
                failureOutput     : failureOutput,
                candidateFiles    : [],
                sourceSnippets    : {},
                lineNumber        : lineNumber,
                relativeSourcePath: relativeSourcePath,
                contextFound      : false,
                reason            : "File extension is not allowed: " & fileExtension
            };
        }

        if ( !fileExists( sourcePath ) ) {
            return {
                repoPath          : repoPath,
                failureOutput     : failureOutput,
                candidateFiles    : [],
                sourceSnippets    : {},
                lineNumber        : lineNumber,
                relativeSourcePath: relativeSourcePath,
                contextFound      : false,
                reason            : "Configured source file not found: " & relativeSourcePath
            };
        }

        sourceCode = fileRead( sourcePath );

        // candidateFiles and the sourceSnippets key both use the repository-relative path,
        // so the RepairAgent can join it to the repo root and land on the real file.
        failureContext = {
            repoPath          : repoPath,
            failureOutput     : failureOutput,
            candidateFiles    : [ relativeSourcePath ],
            sourceSnippets    : {
                "#relativeSourcePath#": sourceCode
            },
            lineNumber        : lineNumber,
            relativeSourcePath: relativeSourcePath,
            allowedExtensions : config.allowedExtensions,
            contextFound      : true
        };

        return failureContext;
    }

}
