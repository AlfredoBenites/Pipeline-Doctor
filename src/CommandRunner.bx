class {

    function run( required config, required repoPath ) {

        startTime = getTickCount();

        try {

            result = systemExecute(
                name: config.executable,
                arguments: config.arguments,
                timeout: config.timeoutSeconds,
                terminateOnTimeout: true,
                directory: repoPath
            );

            endTime = getTickCount();

            commandResult = {
                // `succeeded` is the shared contract field read by SafetyGuard.
                // `success` is kept as an alias so older callers keep working.
                succeeded: result.exitCode == 0,
                success: result.exitCode == 0,
                command: config.executable & " " & config.arguments.toList( " " ),
                exitCode: result.exitCode,
                stdout: result.output,
                stderr: result.error,
                combinedOutput: result.output & result.error,
                durationMs: endTime - startTime,
                timedOut: result.timeout,
                terminated: result.terminated,
                started: true
            };

            return commandResult;

        } catch ( any error ) {

            endTime = getTickCount();

            commandResult = {
                succeeded: false,
                success: false,
                command: config.executable & " " & config.arguments.toList( " " ),
                exitCode: -1,
                stdout: "",
                stderr: error.message,
                combinedOutput: error.message,
                durationMs: endTime - startTime,
                timedOut: false,
                terminated: false,
                started: false
            };

            return commandResult;
        }
    }

}